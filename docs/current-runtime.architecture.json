    {
      "dot": "emerald",
      "title": "Accuracy path",
      "items": [
        "AX nodes become opaque document-scoped refs",
        "Actions re-resolve semantic identity and run stable hit testing",
        "Bounded observations and single-use cursors keep reads predictable"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed path",
      "items": [
