{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/longmiaoo/dsh-native-browser/blob/main/protocol/v1.schema.json",
  "title": "DSH Native Browser development wire protocol v1",
  "description": "Generated from packages/contracts/src/wire.ts. Envelope validation is not method-payload authorization.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "const": true
        },
        "value": {}
      },
      "required": [
        "type",
        "id",
        "ok",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "POLICY_DENIED",
            "LEASE_BUSY",
            "LEASE_REVOKED",
            "USER_STOPPED",
            "CANCELLED",
            "DEADLINE_EXCEEDED",
            "QUEUE_FULL",
            "CONNECTION_LOST",
            "PROTOCOL_MISMATCH",
            "STALE_TARGET",
            "AMBIGUOUS_TARGET",
            "NOT_ACTIONABLE",
            "UNSUPPORTED_CAPABILITY",
            "NAVIGATION_FAILED",
            "VISION_UNAVAILABLE",
            "REQUEST_ID_CONFLICT",
            "JOURNAL_FULL",
            "JOURNAL_UNAVAILABLE",
            "RECOVERY_REQUIRED",
            "BROKER_BUSY",
            "BROKER_STATE_UNSAFE",
            "INTERNAL_ERROR"
          ]
        }
      },
      "required": [
        "type",
        "id",
        "ok",
        "code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "value": {}
      },
      "required": [
        "type",
        "event",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "cancel"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "hello": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bootstrap": {
              "const": 1
            },
            "versions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "requiredCapabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              }
            },
            "role": {
              "const": "client"
            },
            "journalKey": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "bootstrap",
            "versions",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bootstrap": {
              "const": 1
            },
            "versions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "requiredCapabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              }
            },
            "role": {
              "const": "provider"
            },
            "capabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              }
            },
            "instance": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "family": {
                  "const": "chromium"
                },
                "brand": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "profileLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "id",
                "family",
                "brand",
                "version",
                "profileLabel"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "bootstrap",
            "versions",
            "role",
            "capabilities",
            "instance"
          ],
          "additionalProperties": false
        }
      ]
    },
    "welcome": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "connectionEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          }
        }
      },
      "required": [
        "version",
        "connectionEpoch",
        "capabilities"
      ],
      "additionalProperties": false
    }
  }
}
